# Docker 部署配置。复制为 .env 后按需修改，或直接运行 ./deploy.sh 自动生成。
# 用户的渠道、Key、画布数据都保存在浏览器本地，服务端只存参考素材临时文件。

# 宿主机映射端口
C_AI_HOST_PORT=9527

# 容器名与镜像名。同一台机器部署多个实例时必须改成不同值，否则会互相顶掉。
C_AI_CONTAINER_NAME=infinite-canvas
C_AI_IMAGE_NAME=c-aihuabu:local

# 站点公网 HTTPS 域名。参考素材上传后要回传这个地址给上游模型拉取；
# 留空会导致图生视频等需要公网素材的功能提交失败。
C_AI_PUBLIC_BASE_URL=

# 参考素材临时上传目录（容器内路径）与保留天数
C_AI_UPLOAD_DIR=/data/uploads/references
C_AI_UPLOAD_TTL_DAYS=15

# 上传目录在宿主机的挂载位置
C_AI_UPLOAD_HOST_DIR=./data/uploads

# 可选：上传目录容量上限（字节），留空使用内置默认值
C_AI_UPLOAD_MAX_DIR_BYTES=

# 会员、积分和后台管理服务。JWT 密钥至少 32 位，生产环境必须随机生成并妥善保存。
C_AI_JWT_SECRET=
C_AI_TOKEN_TTL_HOURS=168
C_AI_DATABASE_PATH=/data/business/c-aihuabu.db
C_AI_BUSINESS_HOST_DIR=./data/business

# 首次启动时创建管理员；创建后可移除密码环境变量。
C_AI_ADMIN_EMAIL=
C_AI_ADMIN_PASSWORD=

# 随行付/天阙支付。密钥只配置在服务器环境变量，不要提交到 Git。
C_AI_TIANQUE_ENABLED=false
C_AI_TIANQUE_SANDBOX=true
C_AI_TIANQUE_HOST=https://openapi-test.tianquetech.com
C_AI_TIANQUE_HOST_PROD=https://openapi.tianquetech.com
C_AI_TIANQUE_ORG_ID=
C_AI_TIANQUE_MNO=
C_AI_TIANQUE_SUB_MECH_ID=
C_AI_TIANQUE_SIGN_TYPE=RSA
C_AI_TIANQUE_VERSION=1.2
C_AI_TIANQUE_PRIVATE_KEY=
C_AI_TIANQUE_PUBLIC_KEY=
C_AI_TIANQUE_NOTIFY_URL=https://ai.vvj.me/api/payment/notify/tianque
